# CampusMate AI — environment template (DESIGN.md §6.2)
# Copy to .env and fill in real values. Never commit a real key (AGENTS §7).

# Required unless MOCK_LLM=true (FR-18)
GEMINI_API_KEY=your_key_here

# Models (verify availability in Phase 3)
GEMMA_MODEL_ID=gemma-3-27b-it
GEMMA_FALLBACK_MODEL_ID=gemma-3-12b-it

# Retrieval / abstention gate (threshold calibrated Phase 6 — see docs/DECISIONS.md)
BM25_MIN_SCORE=10.5
BM25_TOP_K=5

# API limits (FR-19)
RATE_LIMIT_PER_MINUTE=60

# Dev/QA canned mode, no key needed (FR-21)
MOCK_LLM=false

# Server
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
